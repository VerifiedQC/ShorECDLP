      (primitiveResources (secp256k1EEAForwardAdaptive r)).toffoli := by
  have h := measuredIndexedSchedule_toffoli r 256 1 1620 hl hw
  rw [measuredScheduleSavings_secp256k1] at h
  exact h

/-- The same exact reduction in the actual descending adaptive program. -/
theorem secp256k1MeasuredEEAReverse_toffoli (r : IndexedStepRegisters)
    (hl : Secp256k1ScheduleLayout r) (hw : 2 ≤ r.lengthT.length) :
    (primitiveResources (secp256k1MeasuredEEAReverse r)).toffoli + 1681736 =
      (primitiveResources (secp256k1EEAReverseAdaptive r)).toffoli := by
  have h := measuredIndexedScheduleInverse_toffoli r 256 1 1620 hl hw
  rw [measuredScheduleSavings_secp256k1] at h
  exact h
/-- The new 1,620-step forward program implements the same strict EEA on actual-prefix inputs. -/
theorem secp256k1MeasuredEEAForward_coherent (r : IndexedStepRegisters)
    (hl : Secp256k1ScheduleLayout r) :
    CoherentlyImplementsOn (secp256k1MeasuredEEAForward r)
      (Quantum.run (secp256k1EEAForwardUnitary r))
      (IndexedScheduleAdaptiveInput r 256 1 secp256k1ScheduleLength) := by
  exact measuredIndexedSchedule_coherent r 256 1 secp256k1ScheduleLength hl

/-- The new inverse program retains the explicit per-step H-entry and tail conditions. -/
theorem secp256k1MeasuredEEAReverse_coherent (r : IndexedStepRegisters)
    (hl : Secp256k1ScheduleLayout r) :
    CoherentlyImplementsOn (secp256k1MeasuredEEAReverse r)
      (Quantum.run (secp256k1EEAReverseUnitary r))
      (MeasuredScheduleInverseInput r 256 1 secp256k1ScheduleLength) := by
  exact measuredIndexedScheduleInverse_coherent r 256 1 secp256k1ScheduleLength hl

/-- Physical well-formedness of the pinned forward program. -/
theorem secp256k1MeasuredEEAForward_wellFormed (r : IndexedStepRegisters)
